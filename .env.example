# Telegram bot (ticker in, result out). Dedicated BotFather token only.
TRADINGAGENTS_TG_BOT_TOKEN=
# Comma-separated Telegram user/chat IDs (fail-closed: empty = bot idles).
TRADINGAGENTS_TG_ALLOWED_IDS=
#TRADINGAGENTS_TG_POLL_SECONDS=2

# LLM routing: primary URL + models (default OpenRouter), TRADINGAGENTS_*
# backend secondary. Point PRIMARY_URL at a local OmniRoute gateway
# (needs OMNIROUTE_API_KEY) to use it as default.
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=
TRADINGAGENTS_TG_PRIMARY_URL=https://openrouter.ai/api/v1
TRADINGAGENTS_TG_PRIMARY_DEEP=deepseek/deepseek-chat-v3-0324
TRADINGAGENTS_TG_PRIMARY_QUICK=qwen/qwen3-coder
#TRADINGAGENTS_TG_PRIMARY_URL=http://188.132.174.62:3000/v1
#TRADINGAGENTS_TG_PRIMARY_DEEP=auto/best-coding
#TRADINGAGENTS_TG_PRIMARY_QUICK=auto/best-fast
#TRADINGAGENTS_MAX_TOKENS=8192

# Result logging to Notion (see scripts/log_research_to_notion.py).
NOTION_API_KEY=
