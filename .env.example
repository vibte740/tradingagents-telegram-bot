# Telegram bot (ticker in, result out). Dedicated BotFather token only.
TRADINGAGENTS_TG_BOT_TOKEN=
# Comma-separated Telegram user/chat IDs (fail-closed: empty = bot idles).
TRADINGAGENTS_TG_ALLOWED_IDS=
#TRADINGAGENTS_TG_POLL_SECONDS=2

# Primary LLM backend is the standard TRADINGAGENTS_* config. Fallback when
# the primary is unreachable: OpenRouter :free models.
OPENROUTER_API_KEY=
TRADINGAGENTS_TG_FALLBACK_DEEP=nvidia/nemotron-3-ultra-550b-a55b:free
TRADINGAGENTS_TG_FALLBACK_QUICK=poolside/laguna-s-2.1:free

# Result logging to Notion (see scripts/log_research_to_notion.py).
NOTION_API_KEY=
